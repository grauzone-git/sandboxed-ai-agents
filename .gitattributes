# Keep text checkouts consistent on Linux and Windows, regardless of core.autocrlf.
# Auto-detection leaves binary files unchanged. PowerShell 7 also accepts LF.
* text=auto eol=lf

# These files run in Linux containers even when the checkout lives on Windows.
/src/container/** text eol=lf
*.sh text eol=lf
/sandbox text eol=lf
/tests/run text eol=lf
